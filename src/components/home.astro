---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import { profile, stats } from "@/data/profile";

const iconBtn =
  "text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:-translate-y-0.5";

const socials = [
  {
    href: profile.socials.github,
    label: "GitHub",
    path: "M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z",
  },
  {
    href: profile.socials.linkedin,
    label: "LinkedIn",
    path: "M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z",
  },
  {
    href: profile.socials.leetcode,
    label: "LeetCode",
    path: "M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z",
  },
];
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:pt-40 md:pb-24 pb-14">
    <div class="text-left space-y-4">
      <div class="flex flex-wrap items-center gap-3 hero-in" style="--d:0ms">
        <p class="text-md md:text-lg text-[var(--white-icon)]">
          Hi, I'm {profile.firstName} 👋
        </p>
        <span
          class="inline-flex items-center gap-2 text-xs md:text-sm text-[var(--white-icon)] border border-[var(--white-icon-tr)] bg-[#1414149c] rounded-full px-3 py-1"
        >
          <span class="relative flex size-2">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75 animate-ping"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-[var(--accent)]"
            ></span>
          </span>
          Open to opportunities · {profile.location}
        </span>
      </div>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-7xl font-medium text-pretty leading-none hero-in"
          style="--d:80ms"
        >
          Backend &amp; AI <br /> Engineer
        </h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)] hero-in" style="--d:160ms">
          Architecting scalable backend systems, analytical APIs, and
          production-grade{" "}
          <span class="text-[var(--sec)] shiny-sec">Generative AI</span> workflows
          with Python.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 pt-3 md:pt-6 hero-in" style="--d:240ms">
        {
          socials.map((s) => (
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={s.href}
              aria-label={s.label}
              title={s.label}
              class={iconBtn}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-8"
              >
                <path d={s.path} />
              </svg>
            </a>
          ))
        }
        <a
          href={`mailto:${profile.email}`}
          aria-label="Email"
          title="Email"
          class={iconBtn}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-8">
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>
        <a
          id="download-resume"
          href={profile.resume}
          target="_blank"
          rel="noopener"
          class="resume-btn group inline-flex items-center gap-2 h-[58px] px-5 rounded-xl font-medium text-[var(--background)] bg-[var(--sec)] hover:-translate-y-0.5 transition duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-5 transition-transform duration-300 group-hover:translate-y-0.5"
          >
            <path
              d="M13 10H18L12 16L6 10H11V3H13V10ZM4 19H20V12H22V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V12H4V19Z"
            ></path>
          </svg>
          Resume
        </a>
      </div>

      <dl class="grid grid-cols-3 gap-3 md:gap-6 pt-6 max-w-xl hero-in" style="--d:320ms">
        {
          stats.map((s) => (
            <div class="border-l border-[var(--white-icon-tr)] pl-3 md:pl-4">
              <dt class="sr-only">{s.label}</dt>
              <dd class="text-2xl md:text-3xl font-semibold text-[var(--white)]">
                {s.value}
              </dd>
              <dd class="text-xs md:text-sm text-[var(--white-icon)]">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8" data-reveal>
      <SkillsList client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:visible
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }

  .hero-in {
    opacity: 0;
    transform: translateY(16px);
    animation: hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .resume-btn {
    box-shadow: 0 0 0 0 #a476ff00;
  }

  .resume-btn:hover {
    box-shadow: 0 8px 30px -6px #a476ff80;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
