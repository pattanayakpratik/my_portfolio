---
import { techStack } from "@/data/profile";
---

<div class="relative overflow-x-hidden py-8" aria-label="Technologies I work with">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"></div>

  <div class="flex animate-scroll w-max will-change-transform hover:[animation-play-state:paused]">
    {
      [...techStack, ...techStack].map((tech, index) => (
        <div
          class="flex items-center gap-2 pr-12 md:pr-20 group transition-all duration-300"
          aria-hidden={index >= techStack.length ? "true" : "false"}
        >
          <img
            src={`/svg/tech/${tech.icon}.svg`}
            alt=""
            class="h-7 w-7 object-contain brightness-0 invert opacity-50 transition duration-300 group-hover:opacity-100 group-hover:scale-110"
            width="28"
            height="28"
            loading={index < techStack.length ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="text-lg font-medium text-[var(--white-icon)] whitespace-nowrap transition-colors duration-300 group-hover:text-[var(--white)]">
            {tech.name}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }
</style>