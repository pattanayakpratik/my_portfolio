---
import { Image } from "astro:assets";
import cypherImg from "@/assets/projects/cypher.png";
import pyshareImg from "@/assets/projects/pyshare.png";
import { featuredProjects, otherProjects, profile } from "@/data/profile";

const images: Record<string, { src: typeof cypherImg; pad: string }> = {
  // Both are square artwork (mascot / app icon) -> centered with breathing room
  cypher: { src: cypherImg, pad: "p-6 md:p-8" },
  pyshare: { src: pyshareImg, pad: "p-10 md:p-14" },
};

const iconBtn =
  "size-12 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]";

const githubPath =
  "M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z";
---

<section
  id="projects"
  class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <div data-reveal>
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
      <h3 class="text-4xl md:text-5xl font-medium mb-10">Projects</h3>
    </div>

    <!-- Featured projects -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        featuredProjects.map((project, i) => (
          <article
            class="group card overflow-hidden flex flex-col"
            data-reveal
            style={`--reveal-delay:${i * 120}ms`}
          >
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="project-media relative block overflow-hidden h-56 md:h-72"
              aria-label={`${project.title} on GitHub`}
            >
              <Image
                src={images[project.image].src}
                alt={`${project.title} — ${project.tagline}`}
                widths={[480, 800, 1100]}
                sizes="(min-width: 768px) 500px, 100vw"
                class={`w-full h-full object-contain ${images[project.image].pad} transition-transform duration-500 ease-out group-hover:scale-105`}
              />
            </a>

            <div class="flex flex-col flex-grow p-5 md:p-6 gap-4">
              <div class="flex items-start gap-4">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold">{project.title}</h4>
                  <p class="text-sm text-[var(--sec)]">{project.tagline}</p>
                </div>
                <a
                  target="_blank"
                  rel="noopener noreferrer"
                  href={project.repo}
                  aria-label={`${project.title} source code`}
                  class={`${iconBtn} shrink-0`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-6"
                  >
                    <path d={githubPath} />
                  </svg>
                </a>
              </div>

              <p class="text-[var(--white-icon)] text-sm md:text-base">
                {project.description}
              </p>

              <ul class="space-y-2 text-sm text-[var(--white-icon)]">
                {project.highlights.map((h) => (
                  <li class="flex gap-2">
                    <span class="text-[var(--sec)] mt-[2px]">▹</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-2 mt-auto pt-2">
                {project.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Other projects -->
    <h4 class="text-2xl font-medium mt-16 mb-6" data-reveal>
      More things I've built
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        otherProjects.map((p, i) => (
          <a
            href={p.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="mini-card group card p-5 flex flex-col gap-3 hover:-translate-y-1"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 90}ms`}
          >
            <div class="flex items-center justify-between">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-7 text-[var(--sec)]"
                aria-hidden="true"
              >
                <path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z" />
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5 text-[var(--white-icon)] transition-all duration-300 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              >
                <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
              </svg>
            </div>
            <h5 class="text-lg font-semibold group-hover:text-[var(--sec)] transition-colors">
              {p.title}
            </h5>
            <p class="text-sm text-[var(--white-icon)] flex-grow">
              {p.description}
            </p>
            <div class="flex flex-wrap gap-2 pt-1">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>

    <a
      target="_blank"
      rel="noopener noreferrer"
      href={profile.socials.github}
      aria-label="More projects on GitHub"
      class="w-full flex items-center justify-center gap-2 mt-10 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-[1.02]"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path d={githubPath}></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .project-media {
    background:
      radial-gradient(120% 80% at 50% 0%, #a476ff2e 0%, transparent 60%),
      radial-gradient(80% 60% at 50% 110%, #5e44913a 0%, transparent 70%),
      #141414;
    border-bottom: 1px solid var(--white-icon-tr);
  }
</style>
