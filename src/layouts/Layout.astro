---
import { profile } from "@/data/profile";

interface Props {
  title: string;
  description?: string;
}

const { title, description = profile.summary } = Astro.props;

// Canonical / OG URLs are only emitted once `site` is set in astro.config.mjs
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL("/og.image.png", Astro.site).href : "/og.image.png";
const pageTitle = `${title} | ${profile.role}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {siteUrl && <link rel="canonical" href={siteUrl} />}
    <link rel="sitemap" href="/sitemap.xml" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    {siteUrl && <meta property="og:url" content={siteUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data (JSON-LD) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: profile.name,
        url: siteUrl ?? undefined,
        email: `mailto:${profile.email}`,
        jobTitle: profile.role,
        description: profile.summary,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Mumbai",
          addressRegion: "Maharashtra",
          addressCountry: "IN",
        },
        sameAs: Object.values(profile.socials),
        knowsAbout: [
          "Python",
          "Backend Engineering",
          "Generative AI",
          "Machine Learning",
          "REST APIs",
          "SQL",
        ],
      })}
    />

    <!-- Enables reveal-on-scroll styles only when JS is available -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <div class="ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb--1"></span>
      <span class="ambient-orb ambient-orb--2"></span>
    </div>
    <slot />

    <script>
      // Reveal-on-scroll for any element with [data-reveal]
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #22d3ee;
    --accent: #a9ff5b;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
    --component-bg: #161616e6;
    --container: #101010;
    --line: #2a2a2a;
    --pink: #22d3ee;
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  body {
    overflow-x: hidden;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Ambient background glow */
  .ambient {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(120px);
    opacity: 0.16;
    animation: drift 22s ease-in-out infinite alternate;
  }

  .ambient-orb--1 {
    width: 520px;
    height: 520px;
    background: var(--sec);
    top: -160px;
    right: -120px;
  }

  .ambient-orb--2 {
    width: 420px;
    height: 420px;
    background: #0e7490;
    bottom: -180px;
    left: -140px;
    animation-delay: -11s;
  }

  @keyframes drift {
    to {
      transform: translate3d(-60px, 80px, 0) scale(1.1);
    }
  }

  /* Reveal on scroll */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .js [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Reusable card surface */
  .card {
    background: #1414149c;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1rem;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  .card:hover {
    border-color: #22d3ee40;
    background: #10191c9c;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    color: var(--white-icon);
    border: 1px solid var(--white-icon-tr);
    background: #ffffff06;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .js [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .ambient-orb,
    .animate-scroll,
    .shiny-sec {
      animation: none !important;
    }
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
